{
  "name": "@local-llm/workspace",
  "private": true,
  "version": "1.0.5",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build:native": "pnpm --filter @local-llm/native build",
    "build": "pnpm --filter local-llm build",
    "smoke:native": "pnpm --filter @local-llm/native run clean && pnpm --filter @local-llm/native exec cmake-js compile --CDGGML_METAL=OFF --CDLLAMA_BUILD_TESTS=OFF --CDLLAMA_BUILD_EXAMPLES=OFF --CDLLAMA_BUILD_TOOLS=OFF --CDLLAMA_BUILD_SERVER=OFF && node scripts/smoke-native-addon.js",
    "verify:core-version": "node scripts/verify-core-version.mjs packages/local-llm/package.json",
    "verify:release": "node scripts/validate-release.mjs",
    "release": "node scripts/release.mjs",
    "test": "npx tsx scripts/test-full.ts",
    "test:unit": "pnpm --filter local-llm test",
    "test:integration": "npx tsx scripts/test-full.ts",
    "test:native": "node scripts/test-addon.js",
    "test:native-lifetime": "node scripts/test-native-lifetime.js",
    "test:downloader": "npx tsx scripts/test-downloader.ts",
    "test:openai": "npx tsx scripts/test-openai.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
